    "def possible_repairs(df, row1_idx, row2_idx):\n",
    "    \"\"\"\n",
    "    Generates all possible repairs for a functional dependency violation between two rows.\n",
    "    For the FD album, year -> genre, the possible repairs are:\n",
    "    1. Delete first row\n",
    "    2. Delete second row\n",
    "    3. Update genre of first row to match second row\n",
    "    4. Update genre of second row to match first row\n",
    "    \n",
    "    Args:\n",
    "        df: DataFrame containing the data\n",
    "        row1_idx: Index of the first row in violation\n",
    "        row2_idx: Index of the second row in violation\n",
    "    \n",
    "    Returns:\n",
    "        List of repair operations, each represented as a dictionary with operation details\n",
    "    \"\"\"\n",
    "    row1 = df.iloc[row1_idx]\n",
    "    row2 = df.iloc[row2_idx]\n",
    "    \n",
    "    repairs = []\n",
    "    \n",
    "    # Repair 1: Delete first row\n",
    "    repairs.append({\n",
    "        'operation': 'delete',\n",
    "        'row_index': row1_idx,\n",
    "        'description': f\"Delete row {row1_idx} (song: {row1['song_title']})\"\n",
    "    })\n",
    "    \n",
    "    # Repair 2: Delete second row\n",
    "    repairs.append({\n",
    "        'operation': 'delete',\n",
    "        'row_index': row2_idx,\n",
    "        'description': f\"Delete row {row2_idx} (song: {row2['song_title']})\"\n",
    "    })\n",
    "    \n",
    "    # Repair 3: Update genre of first row to match second row\n",
    "    repairs.append({\n",
    "        'operation': 'update',\n",
    "        'row_index': row1_idx,\n",
    "        'attribute': 'genre',\n",
    "        'new_value': row2['genre'],\n",
    "        'old_value': row1['genre'],\n",
    "        'description': f\"Update row {row1_idx} genre from '{row1['genre']}' to '{row2['genre']}'\"\n",
    "    })\n",
    "    \n",
    "    # Repair 4: Update genre of second row to match first row\n",
    "    repairs.append({\n",
    "        'operation': 'update',\n",
    "        'row_index': row2_idx,\n",
    "        'attribute': 'genre',\n",
    "        'new_value': row1['genre'],\n",
    "        'old_value': row2['genre'],\n",
    "        'description': f\"Update row {row2_idx} genre from '{row2['genre']}' to {row1['genre']}'\"\n",
    "        )\n",
    "  \n",
    "    return repairs\n",
    "\n",
    "# Test the function with the first violation found earlier\n",
    "if violations:\n",
    "    print(\"Possible repairs for the first violation:\\n\")\n",
    "    row1_idx, row2_idx = violations[0]\n",
    "    display_violation(data, row1_idx, row2_idx)\n",
    "    repairs = possible_repairs(data, row1_idx, row2_idx)\n",
    "    for j, repair in enumerate(repairs, 1):\n",
    "        print(f\"  Repair {j}: {repair['description']}\")\n",
    "else:\n",
    "    print(\"No violations found, so no repairs needed.\")\n",
    "    # Demonstrate with a hypothetical violation for testing\n",
    "    print(\"\\nDemonstrating repair generation with hypothetical violation between rows 0 and 1:\")\n",
    "    display_violation(data, 0, 1)\n",
    "    demo_repairs = possible_repairs(data, 0, 1)\n",
    "    for i, repair in enumerate(demo_repairs, 1):\n",
    "        print(f\"  Repair {i}: {repair['description']}\")"
   ]
