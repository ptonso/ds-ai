    "\n",
    "        repaired_tables.append((current_df, repair_cost))\n",
    "\n",
    "    return repaired_tables\n",
    "\n",
    "def filter_valid_repairs(repaired_tables_with_cost):\n",
    "    \"\"\"\n",
    "    Filters repaired tables to only include those that satisfy the functional dependency.\n",
