    "def apply_single_repair(df, repair):\n",
    "    \"\"\"\n",
    "    Applies a single repair operation to a dataframe.\n",
    "\n",
    "    Args:\n",
    "        df: DataFrame to repair\n",
    "        repair: Dictionary containing repair operation details\n",
    "\n",
    "    Returns:\n",
    "        New DataFrame with the repair applied\n",
    "    \"\"\"\n",
    "    df_repaired = df.copy()\n",
    "\n",
    "    if repair['operation'] == 'delete':\n",
    "        df_repaired = df_repaired.drop(repair['row_index']).reset_index(drop=True)\n",
    "    elif repair['operation'] == 'update':\n",
    "        df_repaired.loc[repair['row_index'], repair['attribute']] = repair['new_value']\n",
    "\n",
    "    return df_repaired\n",
    "\n",
    "def check_fd_satisfaction(df):\n",
    "    \"\"\"\n",
    "    Checks if a dataframe satisfies the functional dependency album, year -> genre.\n",
    "\n",
    "    Args:\n",
    "        df: DataFrame to check\n",
    "\n",
    "    Returns:\n",
    "        Boolean indicating if FD is satisfied (True) or violated (False)\n",
    "    \"\"\"\n",
    "    violations = fd_violations(df)\n",
    "    return len(violations) == 0\n",
    "\n",
    "def cost_of_set_of_repairs(repairs):\n",
    "    \"\"\"\n",
    "    Determines the cost of a set of repairs.\n",
    "    Update operations cost 1, delete operations cost 3.\n",
    "    \n",
    "    Args:\n",
    "        repairs: List of repair dictionaries\n",
    "    \n",
    "    Returns:\n",
    "        Integer representing the total cost\n",
    "    \"\"\"\n",
    "    total_cost = 0\n",
    "    for repair in repairs:\n",
    "        if repair['operation'] == 'delete':\n",
    "            total_cost += 3\n",
    "        elif repair['operation'] == 'update':\n",
    "            total_cost += 1\n",
    "    return total_cost\n",
    "\n",
    "def analyse_repair_set_validity(repairs):\n",
    "    \"\"\"\n",
    "    Analyses a set of repairs and removes redundant or conflicting operations.\n",
    "    - Removes duplicate repairs (same operation and arguments)\n",
    "    - Removes updates to rows that are also being deleted\n",
    "    \n",
    "    Args:\n",
    "        repairs: List of repair dictionaries\n",
    "    \n",
    "    Returns:\n",
    "        List of cleaned repair dictionaries\n",
    "    \"\"\"\n",
    "    cleaned_repairs = []\n",
    "    seen_repairs = set()\n",
    "    deleted_rows = set()\n",
    "    \n",
    "    # First pass: identify deleted rows and collect unique repairs\n",
    "    for repair in repairs:\n",
    "        # Create a unique identifier for each repair\n",
    "        if repair['operation'] == 'delete':\n",
    "            repair_id = ('delete', repair['row_index'])\n",
    "            deleted_rows.add(repair['row_index'])\n",
    "        else:  # update\n",
    "            repair_id = ('update', repair['row_index'], repair['attribute'], repair['new_value'])\n",
    "        \n",
    "        # Only add if we haven't seen this exact repair before\n",
    "        if repair_id not in seen_repairs:\n",
    "            seen_repairs.add(repair_id)\n",
    "            cleaned_repairs.append(repair)\n",
    "    \n",
    "    # Second pass: remove updates to rows that are being deleted\n",
    "    final_repairs = []\n",
    "    for repair in cleaned_repairs:\n",
    "        if repair['operation'] == 'update' and repair['row_index'] in deleted_rows:\n",
    "            # Skip this update because the row is being deleted\n",
    "            continue\n",
    "        final_repairs.append(repair)\n",
    "    \n",
    "    return final_repairs\n",
    "\n",
    "def apply_repairs(df, violations, verbose=False):\n",
    "    \"\"\"\n",
    "    For each violation determines possible repairs, then generates all combinations\n",
    "    of repairs (one per violation) and applies them to create repaired dataframes.\n",
    "\n",
    "    Args:\n",
    "        df: Original dataframe\n",
    "        violations: List of violation pairs\n",
    "        verbose: If True, prints details for each repaired table\n",
    "\n",
    "    Returns:\n",
    "        List of tuples (repaired_dataframe, cost) for all possible repaired dataframes\n",
    "    \"\"\"\n",
    "    if not violations:\n",
    "        return [(df, 0)]\n",
    "\n",
    "    # Get all possible repairs for each violation\n",
    "    all_repairs = []\n",
    "    for row1_idx, row2_idx in violations:\n",
    "        repairs = possible_repairs(df, row1_idx, row2_idx)\n",
    "        all_repairs.append(repairs)\n",
    "\n",
    "    # Generate all combinations of repairs (one repair per violation)\n",
    "    from itertools import product\n",
    "    repair_combinations = list(product(*all_repairs))\n",
    "\n",
    "    repaired_tables = []\n",
    "\n",
    "    # Apply each combination of repairs\n",
    "    for i, repair_combination in enumerate(repair_combinations):\n",
    "        current_df = df.copy()\n",
    "\n",
    "        if verbose:\n",
    "            print(f\"\\nRepaired table {i+1}:\")\n",
    "            print(\"Repair operations:\")\n",
    "\n",
    "        # Sort repairs by operation type and row index to handle deletions properly\n",
    "        # Deletions should be applied in reverse order to avoid index shifting issues\n",
    "        sorted_repairs = sorted(repair_combination,\n",
    "                              key=lambda r: (r['operation'] != 'delete',\n",
    "                                           -r['row_index'] if r['operation'] == 'delete' else r['row_index']))\n",
    "        \n",
    "        # Analyse and clean the repair set\n",
    "        sorted_repairs = analyse_repair_set_validity(sorted_repairs)\n",
    "        \n",
    "        # Calculate the cost of this repair set\n",
    "        repair_cost = cost_of_set_of_repairs(sorted_repairs)\n",
    "\n",
    "        # Apply all repairs in this combination\n",
    "        for repair in sorted_repairs:\n",
    "            if verbose:\n",
    "                print(f\"  - {repair['description']}\")\n",
    "            current_df = apply_single_repair(current_df, repair)\n",
    "\n",
