    "        List of tuples (dataframe, cost) with minimum cost\n",
    "    \"\"\"\n",
    "    if not repaired_tables_with_cost:\n",
    "        return []\n",
    "    \n",
    "    # Find the minimum cost\n",
    "\n",
    "    #################################################################################################\n",
    "    # EXERCISE 2: Determine the minimal cost (i.e., the cost of the repair(s) with the least cost). #\n",
    "    #             Store the minimal cost in variable \"min_cost\"                                     #\n",
    "    #################################################################################################\n",
    "    \n",
    "    # Return only tables with minimum cost\n",
    "    cheapest_tables = [(table, cost) for table, cost in repaired_tables_with_cost if cost == min_cost]\n",
    "    \n",
    "    return cheapest_tables\n",
    "\n",
